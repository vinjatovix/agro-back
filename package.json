{
  "name": "agro-back",
  "version": "1.0.0",
  "description": "agro management back end",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "docker:mongo": "docker-compose -f ./docker/docker-compose.yml up --build -d",
    "restoreDB": "./docker/mongo/scripts/restoreDB.sh",
    "restoreDump": "./docker/mongo/scripts/restoreDump.sh",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "check-circular": "skott --displayMode=raw --showCircularDependencies --tsconfig ./tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix --fix-type problem,layout,suggestion",
    "format": "prettier . --write",
    "check": "npm run lint && prettier . --check",
    "build": "npm run build:clean && npm run build:validate-routes && npm run build:tsc && npm run build:di",
    "build:clean": "rm -r dist; exit 0",
    "build:validate-routes": "tsx ./scripts/validate-routes.ts",
    "build:di": "find ./src -type f \\( -name '*.json' -o -name '*.yml' -o -name '*.yaml' -o -name '*.html' -o -name '*.png' -o -name '*.env' \\) -exec cp --parents {} dist/ \\;",
    "build:tsc": "tsc -p tsconfig.prod.json --sourceMap false",
    "start": "node ./dist/src/index.js",
    "start:local": "npm run build && node ./dist/src/index.js",
    "docker:local": "npm run build && docker compose up --build",
    "test": "npm run test:coverage",
    "test:coverage": "npm run test:clean:coverage && npm run test:all",
    "test:clean:coverage": "rm -rf coverage && rm -rf .c8_output",
    "test:all": "npm run test:unit && npm run test:features",
    "test:unit": "jest --coverage --detectOpenHandles --forceExit",
    "test:unit:watch": "jest --watch --detectOpenHandles --forceExit",
    "test:features": "cross-env NODE_ENV=test NODE_OPTIONS='--loader ts-node/esm' cucumber-js tests/**/*.feature --import ./setupTests.ts --import ./tests/apps/agroApi/features/step_definitions/controller.steps.ts",
    "debug:features": "cross-env NODE_ENV=test NODE_OPTIONS='--loader ts-node/esm' node --inspect-brk ./node_modules/@cucumber/cucumber/bin/cucumber-js tests/apps/agroApi/features/**/*.feature --import ./setupTests.ts --import ./tests/apps/agroApi/features/step_definitions/controller.steps.ts",
    "prepare": "husky"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "jest": {
      "collectCoverage": false
    },
    "report-dir": "coverage",
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "tests/**",
      "**/*.test.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinjatovix/agro-back.git"
  },
  "author": "vinjadevix",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vinjatovix/agro-back/issues"
  },
  "homepage": "https://github.com/vinjatovix/agro-back#readme",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@cucumber/cucumber": "^12.8.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/chance": "^1.1.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/migrate-mongo": "^10.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chance": "^1.1.13",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.8.3",
    "skott": "^0.35.10",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "awilix": "^13.0.3",
    "awilix-express": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "glob": "^13.0.6",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.1.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.0",
    "winston": "^3.19.0",
    "winston-mongodb": "^7.0.1"
  }
}
